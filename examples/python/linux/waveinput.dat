@v300
# Wavedata CFDwavemaker (focused unidirectional wave, case 1)

[wave type]
irregular

[general input data]
depth 1.2
mtheta 0.0000
amplify 0.061
normalize 1

[wave reference point]
# for focused waves this will correspond to the focus point in time and space
time 0.0
x 0.0
y 0.0

[ramps]
#ramptype  rampup_start rampup_end
time_rampup 0.0000 0.5

[wave input irregular]
nfreq 28
# OMEGA [rad/s] A [m]  Phase [rad] Theta [rad]
    5.2033     0.0369     0.0000     0.0000
    5.3014     0.0356     0.0000     0.0000
